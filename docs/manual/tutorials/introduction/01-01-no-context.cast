[0.01,"o","\u001b[92m║\u001b[0m \u001b[0m\u001b[94;1m\u001b[0m\u001b[94;1m\u001b[0m  \u001b[94;1m## \u001b[0m\u001b[94;1mWhat\u001b[0m\u001b[94;1m happened?\u001b[0m\u001b[37m\u001b[0m\r\n"]
[0.01,"o","\u001b[92m║\u001b[0m \u001b[0m\r\n"]
[0.01,"o","\u001b[92m║\u001b[0m \u001b[37m\u001b[0m\u001b[37m\u001b[0m  \u001b[37mHydra needs a context path before it can inspect apps, values, or\u001b[0m\u001b[37m manifests.\u001b[0m\r\n"]
[0.01,"o","\u001b[92m║\u001b[0m \u001b[0m\u001b[37m\u001b[0m\u001b[37m\u001b[0m  \u001b[37mNeither the \u001b[0m\u001b[91;40m --hydra-context \u001b[0m\u001b[37m flag nor the \u001b[0m\u001b[91;40m HYDRA_CONTEXT \u001b[0m\u001b[37m environment variable was\u001b[0m\u001b[37m set.\u001b[0m\r\n"]
[0.01,"o","\u001b[92m║\u001b[0m \u001b[37m\u001b[0m  \u001b[37m\u001b[0m\r\n"]
[0.01,"o","\u001b[92m║\u001b[0m \u001b[0m\u001b[94;1m\u001b[0m\u001b[94;1m\u001b[0m  \u001b[94;1m## \u001b[0m\u001b[94;1mWhy Hydra stops\u001b[0m\u001b[94;1m here\u001b[0m\u001b[37m\u001b[0m\r\n"]
[0.01,"o","\u001b[92m║\u001b[0m \u001b[0m\r\n"]
[0.01,"o","\u001b[92m║\u001b[0m \u001b[37m\u001b[0m\u001b[37m\u001b[0m  \u001b[37mMost local commands need to know which Hydra repository context they should read\u001b[0m\u001b[37m from.\u001b[0m\r\n"]
[0.01,"o","\u001b[92m║\u001b[0m \u001b[0m\u001b[37m\u001b[0m\u001b[37m\u001b[0m  \u001b[37mWithout that path, Hydra cannot resolve clusters or applications\u001b[0m\u001b[37m safely.\u001b[0m\r\n"]
[0.01,"o","\u001b[92m║\u001b[0m \u001b[37m\u001b[0m  \u001b[37m\u001b[0m\r\n"]
[0.01,"o","\u001b[92m║\u001b[0m \u001b[0m\u001b[94;1m\u001b[0m\u001b[94;1m\u001b[0m  \u001b[94;1m## \u001b[0m\u001b[94;1mResolution\u001b[0m\u001b[37m\u001b[0m\r\n"]
