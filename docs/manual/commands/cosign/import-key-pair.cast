{"command":"hydra record cli -- hydra cosign import-key-pair --help","env":{"SHELL":"/bin/bash"},"term":{"cols":120,"rows":36,"type":"xterm-256color"},"version":3}
[0.01,"o","\u001b[1;95m $ \u001b[0m\u001b[1;97mhydra cosign import-key-pair --help\u001b[0m\r\n"]
[0.01,"o","Imports a PEM-encoded RSA or EC private key for signing.\r\n"]
[0.01,"o","\r\n"]
[0.01,"o","Usage:\r\n"]
[0.01,"o","hydra cosign import-key-pair [flags]\r\n"]
[0.01,"o","\r\n"]
[0.01,"o","Examples:\r\n"]
[0.01,"o","  cosign import-key-pair  --key openssl.key --output-key-prefix my-key\r\n"]
[0.01,"o","\r\n"]
[0.01,"o","  # import PEM-encoded RSA or EC private key and write to import-cosign.key and import-cosign.pub files\r\n"]
[0.01,"o","  cosign import-key-pair --key \u003ckey path\u003e\r\n"]
[0.01,"o","\r\n"]
[0.01,"o","  # import PEM-encoded RSA or EC private key and write to my-key.key and my-key.pub files\r\n"]
[0.01,"o","  cosign import-key-pair --key \u003ckey path\u003e --output-key-prefix my-key\r\n"]
[0.01,"o","\r\n"]
[0.01,"o","CAVEATS:\r\n"]
[0.01,"o","  This command interactively prompts for a password. You can use\r\n"]
[0.01,"o","  the COSIGN_PASSWORD environment variable to provide one.\r\n"]
[0.01,"o","\r\n"]
[0.01,"o","Flags:\r\n"]
[0.01,"o","    -h, --help=false:\r\n"]
[0.01,"o","\thelp for import-key-pair\r\n"]
[0.01,"o","\r\n"]
[0.01,"o","    -k, --key='':\r\n"]
[0.01,"o","\timport key pair to use for signing\r\n"]
[0.01,"o","\r\n"]
[0.01,"o","    -o, --output-key-prefix='import-cosign':\r\n"]
[0.01,"o","\tname used for outputted key pairs\r\n"]
[0.01,"o","\r\n"]
[0.01,"o","    -y, --yes=false:\r\n"]
[0.01,"o","\tskip confirmation prompts for overwriting existing key\r\n"]
[0.01,"o","\r\n"]
[0.01,"o","Global Flags:\r\n"]
[0.01,"o","      --color                Force colored output for commands that support colorized stdout\r\n"]
[0.01,"o","      --color-log            Force colored log output (default: auto-detect from terminal)\r\n"]
[0.01,"o","      --color-mode string    Set color mode for commands that support colorized stdout (auto|always|never)\r\n"]
[0.01,"o","      --json-log             Output logs in JSON format (useful for log aggregation)\r\n"]
[0.01,"o","      --less                 Run Hydra in a subprocess and pipe combined stdout+stderr through $PAGER (default: less -SR +G); the child forces --color and --color-log unless explicitly disabled\r\n"]
[0.01,"o","      --no-color             Disable colored output for commands that support colorized stdout\r\n"]
[0.01,"o","      --no-color-log         Disable colored log output\r\n"]
[0.01,"o","      --no-progress          Disable terminal progress bars (use plain log output)\r\n"]
[0.01,"o","      --no-timestamps        Omit timestamps from log messages\r\n"]
[0.01,"o","      --output-file string   log output to a file\r\n"]
[0.01,"o","  -q, --quiet                Only show warnings and errors\r\n"]
[0.01,"o","  -t, --timeout duration     timeout for commands (default 3m0s)\r\n"]
[0.01,"o","  -d, --verbose              log debug output\r\n"]
